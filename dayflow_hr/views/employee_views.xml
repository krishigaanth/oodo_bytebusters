<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Employee Inherited Form View -->
        <record id="view_employee_form_inherit_dayflow" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.dayflow</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='mobile_phone']" position="after">
                    <field name="employee_code"/>
                    <field name="office_location"/>
                    <field name="employment_type"/>
                    <field name="joining_date"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Dayflow HRMS Config">
                        <group>
                            <group string="Work Schedule">
                                <field name="working_days_per_week"/>
                                <field name="break_time"/>
                                <field name="attendance_status_custom"/>
                            </group>
                            <group string="Payroll Settings">
                                <field name="monthly_wage"/>
                                <field name="avatar_url"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
