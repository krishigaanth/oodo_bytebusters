<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Salary Components -->
        <record id="salary_comp_hra" model="dayflow.salary.component">
            <field name="name">House Rent Allowance (HRA)</field>
            <field name="component_code">COMP-01</field>
            <field name="category">Earning</field>
            <field name="type">percentage</field>
            <field name="value">40.0</field>
            <field name="description">40% of base salary provided for housing allowance</field>
            <field name="enabled">1</field>
        </record>

        <record id="salary_comp_transport" model="dayflow.salary.component">
            <field name="name">Transport Allowance</field>
            <field name="component_code">COMP-02</field>
            <field name="category">Earning</field>
            <field name="type">fixed</field>
            <field name="value">3000.0</field>
            <field name="description">Standard monthly travel allowance</field>
            <field name="enabled">1</field>
        </record>

        <record id="salary_comp_special" model="dayflow.salary.component">
            <field name="name">Special Allowance</field>
            <field name="component_code">COMP-03</field>
            <field name="category">Earning</field>
            <field name="type">percentage</field>
            <field name="value">15.0</field>
            <field name="description">Performance and role special allowance</field>
            <field name="enabled">1</field>
        </record>

        <record id="salary_comp_pf" model="dayflow.salary.component">
            <field name="name">Provident Fund (PF)</field>
            <field name="component_code">COMP-04</field>
            <field name="category">Deduction</field>
            <field name="type">percentage</field>
            <field name="value">12.0</field>
            <field name="description">Standard 12% statutory employee contribution</field>
            <field name="enabled">1</field>
        </record>

        <record id="salary_comp_tax" model="dayflow.salary.component">
            <field name="name">Income Tax Deduction</field>
            <field name="component_code">COMP-05</field>
            <field name="category">Deduction</field>
            <field name="type">percentage</field>
            <field name="value">5.0</field>
            <field name="description">Estimated monthly tax withholding</field>
            <field name="enabled">1</field>
        </record>

