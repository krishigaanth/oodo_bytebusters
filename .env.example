# =================================================================
# HRMS PRO - Environment Configuration Example
# Copy this file to .env and configure your Supabase Project values
# =================================================================

# Supabase Project URL (From your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (From your Supabase Project Settings -> API)
# Safe for frontend use with Row Level Security (RLS) enabled
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Company Information Default
VITE_DEFAULT_COMPANY_NAME="Odoo India"
VITE_DEFAULT_COMPANY_CODE="OI"
